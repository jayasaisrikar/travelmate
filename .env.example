# TravelMate Environment Variables

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:6789
NODE_ENV=development

# Supabase (PostgreSQL Database + Auth)
# Get from: https://database.new
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# NVIDIA API (Itinerary Generation + Chat)
# Get from: https://build.nvidia.com/
NVIDIA_KIMI_API_KEY=nvapi-...

# Free Places APIs

# Geoapify (90K free requests/month)
# Get from: https://www.geoapify.com/register
GEOAPIFY_API_KEY=your_key_here

# Nominatim (OpenStreetMap - Unlimited Free)
# No signup needed, use directly
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional: Mapbox (100K free requests/month, for custom maps)
# Get from: https://www.mapbox.com/
MAPBOX_TOKEN=pk_...

# Optional: Weather API
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here
