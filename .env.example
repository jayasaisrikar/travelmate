# TravelMate Environment Variables

# App Configuration
# Use your production domain in Vercel, or localhost while developing.
NEXT_PUBLIC_APP_URL=http://localhost:6789
# Admin dashboard login email.
ADMIN_EMAIL=admin@travelmate.com
# Password for the admin dashboard login.
ADMIN_PASSWORD=...
NODE_ENV=development

# Supabase (PostgreSQL Database + Auth)
# Get from: https://database.new
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# NVIDIA API (Itinerary Generation + Chat)
# Get from: https://build.nvidia.com/
NVIDIA_KIMI_API_KEY=nvapi-...

# Email Delivery
# Use Resend to send app notifications and auth emails.
RESEND_API_KEY=re_...
EMAIL_FROM="TravelMate <your-verified-resend-sender>"
# Optional if you have a real inbox for replies.
EMAIL_REPLY_TO=

# Didit Identity Verification
# Use Didit to power optional traveler trust verification.
DIDIT_API_KEY=your_didit_api_key_here
# Preferred workflow id for the social verification flow.
DIDIT_KYC_WORKFLOW_ID=your_didit_workflow_id_here
# Optional fallback if you use the older variable name.
DIDIT_WORKFLOW_ID=
# Required for webhook signature verification.
DIDIT_WEBHOOK_SECRET=your_didit_webhook_secret_here

# Free Places APIs

# Geoapify (90K free requests/month)
# Get from: https://www.geoapify.com/register
GEOAPIFY_API_KEY=your_key_here

# Nominatim (OpenStreetMap - Unlimited Free)
# No signup needed, use directly
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Optional: Mapbox (100K free requests/month, for custom maps)
# Get from: https://www.mapbox.com/
MAPBOX_TOKEN=pk_...

# Optional: Weather API
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_key_here
